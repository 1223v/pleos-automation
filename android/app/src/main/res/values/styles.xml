<resources>
    <!-- Astryx neutral, light mode (background-body #F1F1F1, accent #1B1B1B). Night values in values-night/. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/window_body</item>
        <item name="android:colorBackground">#F1F1F1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F1F1F1</item>
        <item name="android:navigationBarColor">#F1F1F1</item>
        <item name="android:colorAccent">#1B1B1B</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
