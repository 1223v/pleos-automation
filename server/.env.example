# Copy this file to .env locally. Never commit .env or put provider keys in the APK.
HOST=127.0.0.1
PORT=8787
# Required: randomly generated token of at least 32 characters.
SERVER_AUTH_TOKEN=
# Must remain false until the user configures BOTH a key and budgets.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
AI_MAX_OUTPUT_TOKENS=8192
BUDGET_DB_PATH=.data/budget.sqlite
# Optional HTTPS paths. Non-loopback binding requires HTTPS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# External requests are also disabled until explicitly configured.
CONNECTORS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
HA_BASE_URL=
HA_ACCESS_TOKEN=
# Explicit allowed entity IDs, comma separated; no wildcard.
HA_ALLOWED_ENTITIES=
KAKAO_REST_API_KEY=
WHAT3WORDS_API_KEY=
# Paid conversion calls require this extra opt-in.
WHAT3WORDS_ENABLED=false
